# Cupbearer gateway configuration.
# Copy to .env (or export in your shell) and run: cupbearer setup

# --- gateway ----------------------------------------------------------------
# Default 4143. Anything except 4141/4142 is fine; the port is always yours.
CUPBEARER_PORT=4143
# Loopback only by default: the gateway holds your API keys and does not
# require HTTP auth. Never bind a non-loopback host without understanding that.
CUPBEARER_HOST=127.0.0.1
# Where config.json / secrets.json / logs live (default: ~/.config/cupbearer)
# CUPBEARER_HOME=

# --- provider keys (optional here; the setup wizard stores them in secrets.json) ---
# GROQ_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=
